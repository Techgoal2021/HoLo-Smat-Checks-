{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/dashboard/index.html" },
    { "source": "/chat", "destination": "/dashboard/chat.html" },
    { "source": "/go", "destination": "/dashboard/go.html" },
    { "source": "/style.css", "destination": "/dashboard/style.css" },
    { "source": "/main.js", "destination": "/dashboard/main.js" },
    { "source": "/static/(.*)", "destination": "/dashboard/$1" },
    { "source": "/assets/(.*)", "destination": "/dashboard/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
